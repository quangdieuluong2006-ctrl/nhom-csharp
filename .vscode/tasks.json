{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Biên dịch toàn bộ solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/BookStore.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: chạy và tự tải lại khi sửa code (dotnet watch)",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/BookStore.Web", "--launch-profile", "http"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: chạy kiểm thử",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/BookStore.Tests"],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
