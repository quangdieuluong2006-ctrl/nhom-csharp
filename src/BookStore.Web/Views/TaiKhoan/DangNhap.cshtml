@model DangNhapDto
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-xl-6">
        <div class="card p-4">
            <h1 class="h5 section-title mb-3">Đăng nhập</h1>
            <form method="post" asp-action="DangNhap" asp-route-returnUrl="@ViewBag.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="GhiNho" class="form-check-input" />
                    <label asp-for="GhiNho" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-gold w-100">Đăng nhập</button>
            </form>
            <p class="small text-center mt-3 mb-0">
                Chưa có tài khoản? <a asp-action="DangKy">Đăng ký ngay</a>
            </p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
