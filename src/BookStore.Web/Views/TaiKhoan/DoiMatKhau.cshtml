@model DoiMatKhauDto
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<h1 class="h5 section-title mb-3">Tài khoản của tôi</h1>
<div class="row g-3">
    <div class="col-md-4"><partial name="_MenuTaiKhoan" /></div>
    <div class="col-md-8">
        <div class="card p-4">
            <h2 class="h6 fw-bold mb-3">Đổi mật khẩu</h2>
            <form method="post" asp-action="DoiMatKhau">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="mb-3">
                    <label asp-for="MatKhauCu" class="form-label"></label>
                    <input asp-for="MatKhauCu" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="MatKhauCu" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MatKhauMoi" class="form-label"></label>
                    <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NhapLaiMatKhauMoi" class="form-label"></label>
                    <input asp-for="NhapLaiMatKhauMoi" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NhapLaiMatKhauMoi" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-gold"><i class="bi bi-shield-check"></i> Đổi mật khẩu</button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
