@model IReadOnlyList<DonHangTomTatDto>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<h1 class="h5 section-title mb-3">Đơn hàng của tôi</h1>
<div class="row g-3">
<div class="col-md-4"><partial name="_MenuTaiKhoan" /></div>
<div class="col-md-8">
@if (Model.Count == 0)
{
    <div class="card text-center py-5">
        <p class="mb-2">Bạn chưa có đơn hàng nào.</p>
        <div><a class="btn btn-gold" asp-controller="Sach" asp-action="Index">Mua sách ngay</a></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Mã đơn</th><th>Ngày đặt</th><th class="text-center d-none d-sm-table-cell">Số sách</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var d in Model)
                {
                    var (ten, mau) = HienThi.TrangThai(d.TrangThai);
                    <tr>
                        <td class="fw-semibold">#@d.MaDonHang</td>
                        <td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center d-none d-sm-table-cell">@d.SoSanPham</td>
                        <td class="text-end">@HienThi.Tien(d.TongTien)</td>
                        <td><span class="badge bg-@mau">@ten</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@d.MaDonHang">Chi tiết</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
</div>
</div>
