@model int
@{
    ViewData["Title"] = "Có lỗi xảy ra";
    var (tieuDe, moTa) = Model switch
    {
        404 => ("Không tìm thấy trang", "Trang hoặc cuốn sách bạn tìm không tồn tại hoặc đã ngừng kinh doanh."),
        403 => ("Không có quyền truy cập", "Bạn không có quyền xem nội dung này."),
        _ => ("Hệ thống đang gặp sự cố", "Xin lỗi vì sự bất tiện. Vui lòng thử lại sau ít phút.")
    };
}
<div class="text-center py-5">
    <div class="display-4 fw-bold text-brand">@Model</div>
    <h1 class="h4">@tieuDe</h1>
    <p class="text-muted">@moTa</p>
    @if (ViewBag.MaTraCuu is string ma)
    {
        <p class="small text-muted">Mã tra cứu: <code>@ma</code></p>
    }
    <a class="btn btn-gold" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Về trang chủ</a>
</div>
