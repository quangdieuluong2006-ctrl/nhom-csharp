<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? t + " – " : "")Nhà sách BookStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-brand">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half text-gold"></i> BookStore
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                    aria-controls="nav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Sach" asp-action="Index">Tất cả sách</a></li>
                </ul>
                <form class="d-flex my-2 my-lg-0 me-lg-3 search-box" asp-controller="Sach" asp-action="Index" method="get" role="search">
                    <input class="form-control form-control-sm" type="search" name="tukhoa" placeholder="Tên sách, tác giả, ISBN…"
                           value="@Context.Request.Query["tukhoa"]" aria-label="Tìm kiếm" />
                    <button class="btn btn-gold btn-sm ms-1" type="submit"><i class="bi bi-search"></i></button>
                </form>
                <div class="d-flex align-items-center gap-2">
                    @await Component.InvokeAsync("GioHangTomTat")
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-light dropdown-toggle text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> @User.HoTen()
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="HoSo"><i class="bi bi-person"></i> Tài khoản của tôi</a></li>
                                <li><a class="dropdown-item" asp-controller="DonHang" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng của tôi</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-controller="TaiKhoan" asp-action="DangXuat">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-link text-light text-decoration-none" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                        <a class="btn btn-sm btn-gold" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container my-4">
    <div class="row g-4">
        @* Màn hình lớn: menu là cột bên trái. Điện thoại/máy tính bảng (< 992px): menu thành ngăn kéo trượt (offcanvas)
           mở bằng nút "Danh mục" – chỉ render một lần, không truy vấn CSDL hai lần. *@
        <aside class="col-lg-3">
            <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="menuTrai" aria-labelledby="menuTraiTieuDe">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title h5" id="menuTraiTieuDe">Danh mục sách</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#menuTrai" aria-label="Đóng"></button>
                </div>
                <div class="offcanvas-body d-block">
                    @await Component.InvokeAsync("MenuDanhMuc")
                    @await Component.InvokeAsync("MenuNhaXuatBan")
                </div>
            </div>
        </aside>
        <main class="col-lg-9" role="main">
            <button class="btn btn-outline-secondary btn-sm d-lg-none mb-3" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#menuTrai" aria-controls="menuTrai">
                <i class="bi bi-list"></i> Danh mục &amp; nhà xuất bản
            </button>
            @if (TempData["ThongBao"] is string tb)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @tb <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Loi"] is string loi)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @loi <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<footer class="footer bg-brand text-light py-4 mt-5">
    <div class="container small d-flex flex-wrap justify-content-between gap-2">
        <span>&copy; @DateTime.Now.Year Nhà sách BookStore – Đồ án môn Lập trình C#, Nhóm 01, Trường ĐH Sài Gòn</span>
        <span><i class="bi bi-telephone"></i> 1900 1234 · <i class="bi bi-truck"></i> Giao hàng toàn quốc, thanh toán khi nhận hàng (COD)</span>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
