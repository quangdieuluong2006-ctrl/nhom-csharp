@model DonHangChiTietDto
@{
    ViewData["Title"] = "Đặt hàng thành công";
}
<div class="card p-4">
    <div class="text-center mb-3">
        <i class="bi bi-check-circle-fill text-success fs-1"></i>
        <h1 class="h4 mt-2">Đặt hàng thành công!</h1>
        <p class="text-muted mb-0">Cảm ơn bạn đã mua sách. Cửa hàng sẽ liên hệ xác nhận đơn trong thời gian sớm nhất.</p>
    </div>
    <partial name="_HuongDanThanhToan" model="Model" />
    <partial name="_ChiTietDon" model="Model" />
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-outline-secondary" asp-controller="DonHang" asp-action="Index">Xem đơn hàng của tôi</a>
        <a class="btn btn-gold" asp-controller="Home" asp-action="Index">Tiếp tục mua sắm</a>
    </div>
</div>
